{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "excludes": [
    "**/*-lock.json",
    "**/node_modules",
    "**/references/**",
    ".git",
    ".venv"
  ],
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.25.1",
    "npm:@dprint/markdown@0.25.0",
    "npm:@dprint/toml@0.8.0"
  ]
}
